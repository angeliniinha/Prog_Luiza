@baseUrl = http://127.0.0.1:5000

### 1 — Criar categoria Tradicionais
POST {{baseUrl}}/categorias
Content-Type: application/json

{
    "nome": "Tradicionais"
}

### 2 — Criar categoria Especiais
POST {{baseUrl}}/categorias
Content-Type: application/json

{
    "nome": "Especiais"
}

